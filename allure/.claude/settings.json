{
  "permissions": {
    "deny": [
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(supabase/migrations/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{const f=(JSON.parse(s).tool_input||{}).file_path||'';if(/\\.jsx?$/.test(f))require('child_process').spawnSync('npx eslint --fix \\\"'+f+'\\\"',{stdio:'inherit',shell:true})})\" 2>/dev/null || true",
            "statusMessage": "Running eslint --fix"
          }
        ]
      }
    ]
  }
}
